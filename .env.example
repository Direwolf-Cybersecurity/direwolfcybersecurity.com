# Build-time variables. Copy to .env to override locally; CI sets them as repository variables.

# Where "Log in" and "Sign up" point. Defaults to the production platform origin.
PUBLIC_APP_URL=https://app.direwolfcybersecurity.com

# Optional. When set, the contact form POSTs JSON to this URL (the platform's
# /api/v1/public/contact endpoint). When unset, the form falls back to a mailto: link.
# PUBLIC_CONTACT_ENDPOINT=https://app.direwolfcybersecurity.com/api/v1/public/contact
