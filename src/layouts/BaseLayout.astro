---
/*
 * Heading font: Geist (OFL), self-hosted from the pinned @fontsource-variable/geist package and
 * bundled under /_astro/ (CSP font-src 'self'). Only headings use it (src/styles/global.css); the
 * Latin file is preloaded so headings do not reflow, and the other subsets load only if a page
 * needs their characters (unicode-range).
 */
import '@fontsource-variable/geist/wght.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import {
  SITE_LAUNCHED,
  siteName,
  siteTagline,
  siteDescription,
  siteOrigin,
  PLATFORM_LIVE,
  appUrl,
  contactEndpoint,
} from '../config';

interface Props {
  /** Page title without the site name. */
  title: string;
  description?: string;
  /** Keep this page out of search engines even after launch (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description = siteDescription, noindex = false } = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const fullTitle = isHome ? `${siteName} | ${siteTagline}` : `${title} | ${siteName}`;
const canonicalPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(canonicalPath, siteOrigin).href;
const robots = SITE_LAUNCHED && !noindex ? 'index, follow' : 'noindex, nofollow';

/**
 * Social card: public/og-image.png (1200 x 630), generated with the favicons from the owner's
 * artwork in docs/brand/v2/ by scripts/generate-brand-assets.mjs. Open Graph needs an absolute URL.
 */
const ogImage = new URL('/og-image.png', siteOrigin).href;
const ogImageAlt = `${siteName} logo: a silver wolf in a dark shield with an electric-blue edge beside the name, with the tagline "${siteTagline}"`;

/**
 * Content Security Policy, delivered as a <meta> because GitHub Pages cannot set response
 * headers. It must stay the first thing in <head> after the charset, before any script or
 * stylesheet. Everything is self-hosted: Astro bundles every <script> and <style> into files
 * under /_astro/ (astro.config.mjs keeps them from being inlined) and the no-JavaScript menu
 * fallback is public/noscript.css, so no 'unsafe-inline' or hash sources are needed. The only
 * other origins are the platform (PUBLIC_APP_URL, once PLATFORM_LIVE is true) and the contact
 * endpoint (PUBLIC_CONTACT_ENDPOINT, when set), which the contact form may fetch or post to.
 * frame-ancestors, report-uri and sandbox are ignored in a <meta> policy, so they are absent.
 * `npm run csp` (scripts/check-csp.mjs) checks the built pages against this policy.
 */
const httpsOrigin = (url: string | undefined): string | undefined => {
  if (!url) return undefined;
  try {
    const parsed = new URL(url);
    return parsed.protocol === 'https:' ? parsed.origin : undefined;
  } catch {
    return undefined;
  }
};
const remoteOrigins = [
  ...new Set([PLATFORM_LIVE ? httpsOrigin(appUrl) : undefined, httpsOrigin(contactEndpoint)]),
].filter((origin): origin is string => Boolean(origin));
const remoteSources = remoteOrigins.map((origin) => ` ${origin}`).join('');
const contentSecurityPolicy = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self'${remoteSources}`,
  `form-action 'self'${remoteSources}`,
  "base-uri 'self'",
  "object-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {/* A noindex page (the 404 page) has no canonical URL to point at. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    {/* The header is the near-black band in both schemes (src/components/Header.astro). */}
    <meta name="theme-color" content="#05070d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* Without JavaScript the mobile menu toggle cannot work (src/components/Header.astro). */}
    <noscript>
      <link rel="stylesheet" href="/noscript.css" />
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    {!SITE_LAUNCHED && <PreviewBanner />}
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    {/* Scroll reveal, count-up and header state; bundled to a file under /_astro/ (no inline JS). */}
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
