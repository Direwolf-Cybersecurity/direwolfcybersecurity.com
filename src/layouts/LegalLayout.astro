---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { contactEmail, legalEmail, privacyEmail } from '../config';

interface Props {
  entry: CollectionEntry<'legal'>;
}

const { entry } = Astro.props;
const { title, version, effectiveDate, summary, status } = entry.data;

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const effectiveLabel = dateFormat.format(effectiveDate);
const effectiveIso = effectiveDate.toISOString().slice(0, 10);

/**
 * Every document was published (`status: published`) at launch on 2026-10-23, at the owner's
 * direction and before attorney review (gate G1, open). A published document shows the one
 * in-effect sentence below the version line. A document marked `status: draft` (a future new
 * document, before it takes effect) shows the draft notice instead, so a draft never appears to
 * be in effect.
 */
const isDraft = status === 'draft';

/** Where questions about this document go: the mailbox each document itself names. */
const questionsEmailById: Record<string, string> = {
  terms: legalEmail,
  'acceptable-use': legalEmail,
  accessibility: contactEmail,
  eeo: contactEmail,
};
const questionsEmail = questionsEmailById[entry.id] ?? privacyEmail;
---

<BaseLayout title={title} description={summary}>
  <div class="container-x py-12 md:py-16">
    <p class="text-muted text-sm">
      <a href="/legal/" class="link">
        Legal
      </a>
      <span aria-hidden="true"> / </span>
      <span class="sr-only">, current page: </span>
      {title}
    </p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{title}</h1>
    <p class="text-muted mt-4 max-w-prose text-lg">{summary}</p>

    <dl class="border-line text-muted mt-6 flex flex-wrap gap-x-8 gap-y-2 border-y py-3 text-sm">
      <div class="flex gap-2">
        <dt class="font-medium">Version</dt>
        <dd>
          <code class="font-mono">{version}</code>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="font-medium">Last updated</dt>
        <dd>
          <time datetime={effectiveIso}>{effectiveLabel}</time>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="font-medium">Status</dt>
        <dd>{status === 'published' ? 'In effect' : 'Draft'}</dd>
      </div>
    </dl>

    {isDraft ? (
      <div
        class="bg-accent-soft border-line mt-6 max-w-prose rounded-xl border p-4 text-sm"
        role="note"
        aria-label="Draft notice"
      >
        <p>
          <strong>Draft; not yet in effect.</strong> This document does not bind anyone yet. The
          version that takes effect will carry a new version number and effective date.
        </p>
      </div>
    ) : (
      <p class="text-muted mt-4 max-w-prose text-sm">
        These documents are in effect and are reviewed periodically; the current version is shown
        above.
      </p>
    )}

    <article class="prose mt-8">
      <slot />
    </article>

    <p class="text-muted mt-12 max-w-prose text-sm">
      Questions about this document? Write to{' '}
      <a href={`mailto:${questionsEmail}`} class="link">
        {questionsEmail}
      </a>
      .
    </p>
  </div>
</BaseLayout>
