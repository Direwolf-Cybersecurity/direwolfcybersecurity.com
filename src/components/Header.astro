---
import BrandLogo from './BrandLogo.astro';
import { primaryNav, isCurrent } from '../data/navigation';
import { PLATFORM_LIVE, earlyAccessUrl, loginUrl, signupUrl } from '../config';

/**
 * A near-black band (`.dark-band`) in both color schemes, so the owner's horizontal lockup, which
 * is designed for dark surfaces, always sits on dark. The logo image carries the company name in
 * its alt text; no typed name is set beside it. The logo is 56 px tall from md up and 44 px on
 * phones, so its lettering stays readable, with tight padding so the band is about 76 px tall.
 * Sticky from md up, with no bottom edge at the top of the page (the header and the dark hero or
 * page header read as one band); src/scripts/motion.ts adds `.is-scrolled` (a blue hairline and
 * a shadow) once the page scrolls.
 *
 * Calls to action: "Log in" and "Sign up" while the platform is in service (PLATFORM_LIVE),
 * otherwise a single "Request early access" link to the contact form.
 *
 * Without JavaScript the toggle cannot work: public/noscript.css, loaded by BaseLayout.astro in a
 * <noscript>, hides #menu-toggle and keeps #site-menu open. It is a file rather than an inline
 * <style> so the Content Security Policy's style-src 'self' allows it.
 */
const pathname = Astro.url.pathname;
---

<header class="site-header dark-band" data-site-header>
  <div class="container-x flex flex-wrap items-center justify-between gap-x-4 gap-y-4 py-2.5 lg:gap-x-6">
    <a href="/" class="shrink-0 rounded-md no-underline">
      <BrandLogo height={56} loading="eager" class="h-11 md:h-14" />
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="btn btn-secondary md:hidden"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span data-label>Menu</span>
    </button>

    <div
      id="site-menu"
      class="data-open:flex hidden basis-full flex-col gap-4 pb-2 md:flex md:basis-auto md:flex-row md:items-center md:gap-3 md:pb-0 lg:gap-8"
    >
      <nav aria-label="Primary">
        <ul class="flex flex-col gap-1 md:flex-row md:gap-0.5 lg:gap-5">
          {primaryNav.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href, pathname) ? 'page' : undefined}
                class="text-muted hover:text-fg aria-[current=page]:text-fg block rounded-md px-2 py-2 text-sm font-medium no-underline transition-colors aria-[current=page]:font-semibold md:aria-[current=page]:underline md:aria-[current=page]:decoration-2 md:aria-[current=page]:underline-offset-8"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="flex flex-col gap-3 sm:flex-row">
        {PLATFORM_LIVE ? (
          <>
            <a href={loginUrl} class="btn btn-secondary" rel="noopener noreferrer">
              Log in
            </a>
            <a href={signupUrl} class="btn btn-primary" rel="noopener noreferrer">
              Sign up
            </a>
          </>
        ) : (
          <a href={earlyAccessUrl} class="btn btn-primary">
            Request early access
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('site-menu');
  const label = toggle?.querySelector<HTMLElement>('[data-label]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) menu.setAttribute('data-open', '');
      else menu.removeAttribute('data-open');
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
