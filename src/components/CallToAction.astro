---
import { signupUrl } from '../config';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready when you are.',
  text = 'Create your account, choose the services you need, and deploy sensors from your dashboard. Prefer to talk first? We are happy to.',
} = Astro.props;
---

<section aria-labelledby="cta-heading" class="py-14 md:py-20">
  <div class="container-x">
    <div class="card flex flex-col gap-6 p-8 md:flex-row md:items-center md:justify-between md:p-10">
      <div class="max-w-xl">
        <h2 id="cta-heading" class="text-2xl font-semibold tracking-tight">
          {title}
        </h2>
        <p class="text-muted mt-2">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={signupUrl} class="btn btn-primary">
          Sign up
        </a>
        <a href="/contact/" class="btn btn-secondary">
          Contact us
        </a>
      </div>
    </div>
  </div>
</section>
