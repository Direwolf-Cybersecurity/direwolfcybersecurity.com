---
/**
 * Closing call to action: a near-black panel with a blue edge glow, the same in both color
 * schemes. While the platform is not in service (PLATFORM_LIVE is false) the only button is
 * "Contact us", and the default text invites the reader to tell us what they need and get a quote
 * (claims register row W6; owner direction 2026-10-27: no early access; owner decision
 * 2026-10-29: no wording that the company or the platform is not yet set up). Once the platform
 * is live, "Sign up" returns beside "Contact us".
 */
import { PLATFORM_LIVE, signupUrl } from '../config';

interface Props {
  title?: string;
  text?: string;
  /**
   * No top padding: for when the section before it is on the same background and already ends in
   * its own bottom padding (Home, after Experience), so the two paddings do not stack into a gap.
   */
  flushTop?: boolean;
}

const {
  flushTop = false,
  title = 'Ready when you are.',
  text = PLATFORM_LIVE
    ? 'Create your account, choose the services you need, and deploy sensors from your dashboard. Prefer to talk first? We are happy to.'
    : 'Tell us about your environment and what you need, and we will recommend the right services and send you a quote.',
} = Astro.props;
---

<section aria-labelledby="cta-heading" class={flushTop ? 'pb-16 md:pb-24' : 'py-16 md:py-24'}>
  <div class="container-x" data-reveal>
    <div class="dark-band glow-backdrop brand-panel flex flex-col gap-8 p-8 md:flex-row md:items-center md:justify-between md:p-12">
      <div class="max-w-xl">
        <h2 id="cta-heading" class="text-3xl font-semibold tracking-tight">
          {title}
        </h2>
        <p class="text-muted mt-3 text-lg">{text}</p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        {PLATFORM_LIVE && (
          <a href={signupUrl} class="btn btn-primary" rel="noopener noreferrer">
            Sign up
          </a>
        )}
        <a href="/contact/" class:list={['btn', PLATFORM_LIVE ? 'btn-secondary' : 'btn-primary']}>
          Contact us
        </a>
      </div>
    </div>
  </div>
</section>
