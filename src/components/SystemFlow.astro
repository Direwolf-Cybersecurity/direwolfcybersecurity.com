---
/**
 * The Home "How it works" flow: interface, not illustration. Labelled HTML steps joined by CSS
 * border lines and one CSS-bordered frame ("Direwolf AI SOC"); no SVG and nothing figurative
 * (motion gate 1). Every visible string comes from src/data/flow.ts (claims register row D1).
 *
 * At rest, without JavaScript, with reduced motion, in the `plain` motion tier and in print it is
 * the static, fully drawn diagram: Detect, joined by a line into the frame that holds
 * Investigate and Respond, joined by a second line; the oversight node when shown; and the
 * caption "Illustrative. Not live data." In the `full` tier src/scripts/motion.ts plays it once
 * when its steps are in view (pulses lay the lines down, each step lights as its pulse arrives,
 * the frame lights once, everything rests: 4.25 s), then shows Replay; under Save-Data it shows
 * Play instead and never starts by itself. The figure has no scroll reveal of its own: the run is
 * its entrance, so it never starts while the figure is still fading in. CSS: "Flow" in
 * src/styles/global.css.
 *
 * DOM order is reading order: the three-item list, then the oversight sentence, then the caption.
 * The list keeps role="list" because Safari drops list semantics when list-style is none. The
 * button is never `hidden` (Tailwind's preflight would force display: none): CSS reserves its
 * space from first paint wherever script can show it, so nothing shifts. It is a quiet control
 * for the illustration (muted text, no border until hover or focus), not a call to action.
 */
import Icon from './Icon.astro';
import { flowCaption, flowLegend, flowSteps, oversight } from '../data/flow';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<figure class:list={['flow', oversight.shown && 'has-oversight', className]} data-flow>
  {/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles -- Safari drops list semantics when list-style is none. */}
  <ol class="flow-steps" role="list">
    {flowSteps.map((step, index) => (
      <li class="card flow-step" data-flow-node={step.id}>
        <div class="flex items-center justify-between">
          <span class="icon-tile">
            <Icon name={step.icon} class="h-5 w-5" />
          </span>
          <span class="text-accent font-mono text-sm font-semibold" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
        </div>
        <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
        <p class="text-muted mt-2 text-sm leading-relaxed">{step.text}</p>
        {index < flowSteps.length - 1 && (
          <span class:list={['flow-link', `flow-link-${index + 1}`]} aria-hidden="true">
            <span class="flow-pulse" />
          </span>
        )}
      </li>
    ))}
  </ol>
  <span class="flow-frame" aria-hidden="true">
    <span class="flow-legend eyebrow">{flowLegend}</span>
  </span>
  {oversight.shown && (
    <p class="flow-oversight text-sm font-medium" data-flow-node="oversight">
      <Icon name="users" class="text-accent h-5 w-5" />
      <span>{oversight.text}</span>
      <span class="flow-link flow-link-o" aria-hidden="true">
        <span class="flow-pulse" />
      </span>
    </p>
  )}
  <figcaption class="flow-caption">
    <span class="text-muted text-sm">{flowCaption}</span>
    <button type="button" class="btn flow-replay" data-flow-replay>
      <Icon name="rotate-ccw" class="flow-icon-replay h-4 w-4" />
      <Icon name="play" class="flow-icon-play h-4 w-4" />
      <span data-label>Replay</span>
      <span class="sr-only"> the illustration</span>
    </button>
  </figcaption>
</figure>
