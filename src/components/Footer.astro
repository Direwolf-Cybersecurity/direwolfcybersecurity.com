---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BrandShield from './BrandShield.astro';
import veteranBadge from '../assets/brand/veteran-owned-badge.png';
import { companyNav, trustNav } from '../data/navigation';
import {
  siteName,
  siteTagline,
  ownershipStatement,
  legalEntityName,
  hqLine,
  streetAddress,
  contactEmail,
  phone,
  socials,
  PLATFORM_LIVE,
  earlyAccessUrl,
  loginUrl,
} from '../config';

/**
 * The veteran-owned badge is a generic "Veteran Owned Business" graphic, not the SBA VetCert
 * icon (claims register row F7): it sits only beside the ownership statement (row F1), never
 * beside a product, price or call to action. Showing SBA's own icon instead requires the rules
 * in docs/launch-runbook.md, "Logo use".
 */

const legalDocs = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const telHref = phone ? `tel:${phone.replace(/[^+\d]/g, '')}` : '';
---

<footer class="border-line bg-surface border-t">
  <div class="container-x grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="text-fg flex items-center gap-2 font-semibold no-underline">
        <BrandShield size={32} class="h-8 w-8 shrink-0" />
        <span>{siteName}</span>
      </a>
      <p class="text-muted mt-3 text-sm">{siteTagline}.</p>
      <address class="text-muted mt-4 text-sm not-italic">
        {streetAddress && (
          <span>
            {streetAddress}
            <br />
          </span>
        )}
        {hqLine}
        <br />
        <a href={`mailto:${contactEmail}`} class="link">
          {contactEmail}
        </a>
        {phone && (
          <span>
            <br />
            <a href={telHref} class="link">
              {phone}
            </a>
          </span>
        )}
      </address>
      <div class="mt-4 flex items-center gap-3">
        <Image
          src={veteranBadge}
          alt="Veteran Owned Business"
          width={43}
          height={56}
          densities={[1.5, 2, 3]}
          class="h-14 w-auto shrink-0"
        />
        <p class="text-muted text-sm">{ownershipStatement}. An equal opportunity employer.</p>
      </div>
      {socials.length > 0 && (
        <ul class="mt-4 flex gap-4 text-sm" aria-label="Social profiles">
          {socials.map((s) => (
            <li>
              <a href={s.url} class="link" rel="noopener noreferrer">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company" class="text-sm font-semibold">
        Company
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {companyNav.map(({ label, href }) => (
          <li>
            <a href={href} class="text-muted hover:text-accent no-underline hover:underline">
              {label}
            </a>
          </li>
        ))}
        <li>
          {PLATFORM_LIVE ? (
            <a
              href={loginUrl}
              class="text-muted hover:text-accent no-underline hover:underline"
              rel="noopener noreferrer"
            >
              Log in to the platform
            </a>
          ) : (
            <a
              href={earlyAccessUrl}
              class="text-muted hover:text-accent no-underline hover:underline"
            >
              Request early access
            </a>
          )}
        </li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="text-sm font-semibold">
        Legal
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {legalDocs.map((doc) => (
          <li>
            <a
              href={`/legal/${doc.id}/`}
              class="text-muted hover:text-accent no-underline hover:underline"
            >
              {doc.data.shortTitle ?? doc.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-trust">
      <h2 id="footer-trust" class="text-sm font-semibold">
        Trust
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {trustNav.map(({ label, href }) => (
          <li>
            <a href={href} class="text-muted hover:text-accent no-underline hover:underline">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-line border-t">
    <div class="container-x text-muted flex flex-col gap-2 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>
        &copy; {year} {legalEntityName}. All rights reserved.
      </p>
      <p>{hqLine}</p>
    </div>
  </div>
</footer>
