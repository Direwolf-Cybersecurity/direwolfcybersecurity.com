---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BrandLogo from './BrandLogo.astro';
import veteranBadge from '../assets/brand/veteran-owned-badge.png';
import { companyNav, trustNav } from '../data/navigation';
import {
  siteTagline,
  ownershipStatement,
  legalEntityName,
  hqLine,
  streetAddress,
  contactEmail,
  phone,
  socials,
  PLATFORM_LIVE,
  loginUrl,
} from '../config';

/**
 * A near-black band (`.dark-band`) in both color schemes, carrying the owner's horizontal lockup
 * (src/components/BrandLogo.astro, 80 px tall) with no typed name beside it. On phones the brand
 * column spans the full width and the three link groups sit in two columns, so the footer stays
 * short; each link has vertical padding for a comfortable tap target.
 *
 * The veteran-owned badge is a generic "Veteran Owned Business" graphic, not the SBA VetCert
 * icon (claims register row F7): it sits only beside the ownership statement (row F1), never
 * beside a product, price or call to action. Showing SBA's own icon instead requires the rules
 * in docs/launch-runbook.md, "Logo use".
 */

const legalDocs = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const telHref = phone ? `tel:${phone.replace(/[^+\d]/g, '')}` : '';
const footerLink = 'text-muted hover:text-fg inline-block py-1 no-underline hover:underline';
---

<footer class="dark-band border-line border-t">
  <div class="container-x grid grid-cols-2 gap-x-6 gap-y-10 py-14 md:grid-cols-3 lg:grid-cols-4">
    <div class="col-span-2 md:col-span-3 lg:col-span-1">
      <a href="/" class="inline-block rounded-md no-underline">
        <BrandLogo height={80} class="h-20" />
      </a>
      <p class="text-muted mt-4 text-sm">{siteTagline}.</p>
      <address class="text-muted mt-4 text-sm not-italic">
        {streetAddress && (
          <span>
            {streetAddress}
            <br />
          </span>
        )}
        {hqLine}
        <br />
        <a href={`mailto:${contactEmail}`} class="link">
          {contactEmail}
        </a>
        {phone && (
          <span>
            <br />
            <a href={telHref} class="link">
              {phone}
            </a>
          </span>
        )}
      </address>
      <div class="mt-5 flex items-center gap-3">
        <Image
          src={veteranBadge}
          alt="Veteran Owned Business"
          width={43}
          height={56}
          densities={[1.5, 2, 3]}
          class="h-14 w-auto shrink-0"
        />
        <p class="text-muted text-sm">{ownershipStatement}. An equal opportunity employer.</p>
      </div>
      {socials.length > 0 && (
        <ul class="mt-4 flex gap-4 text-sm" aria-label="Social profiles">
          {socials.map((s) => (
            <li>
              <a href={s.url} class="link" rel="noopener noreferrer">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company" class="text-sm font-semibold">
        Company
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        {companyNav.map(({ label, href }) => (
          <li>
            <a href={href} class={footerLink}>
              {label}
            </a>
          </li>
        ))}
        {/* The column already links to Contact, so the platform link shows only once it is live (row W6). */}
        {PLATFORM_LIVE && (
          <li>
            <a href={loginUrl} class={footerLink} rel="noopener noreferrer">
              Log in to the platform
            </a>
          </li>
        )}
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="text-sm font-semibold">
        Legal
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        {legalDocs.map((doc) => (
          <li>
            <a href={`/legal/${doc.id}/`} class={footerLink}>
              {doc.data.shortTitle ?? doc.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-trust">
      <h2 id="footer-trust" class="text-sm font-semibold">
        Trust
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        {trustNav.map(({ label, href }) => (
          <li>
            <a href={href} class={footerLink}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-line border-t">
    <div class="container-x text-muted py-6 text-xs">
      <p>&copy; {`${year} ${legalEntityName}. All rights reserved.`}</p>
    </div>
  </div>
</footer>
