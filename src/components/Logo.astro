---
/**
 * Direwolf wordmark icon: an angular wolf-head silhouette drawn in-house (no third-party
 * assets). Decorative by default; pass `title` to make it an accessible image.
 */
interface Props {
  class?: string;
  title?: string;
}

const { class: className = 'h-8 w-8', title } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <path
    fill="currentColor"
    fill-rule="evenodd"
    d="M8 6 L22 18 H42 L56 6 L58 30 L48 44 L38 58 L32 62 L26 58 L16 44 L6 30 Z M20 30 L30 28 L28 36 Z M44 30 L34 28 L36 36 Z M29 50 H35 L32 55 Z"
  ></path>
</svg>
