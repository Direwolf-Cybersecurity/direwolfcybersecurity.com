---
/**
 * Title block for secondary pages: the near-black band with the CSS glow backdrop, continuous
 * with the header, in both color schemes. An optional slot sits under the lede (for example a
 * call to action).
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="dark-band glow-backdrop border-line border-b">
  <div class="container-x py-14 md:py-20">
    {eyebrow && <p class="eyebrow accent-sweep">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.03em] text-balance md:text-5xl">
      {title}
    </h1>
    {lede && <p class="text-muted mt-5 max-w-2xl text-lg">{lede}</p>}
    <slot />
  </div>
</div>
