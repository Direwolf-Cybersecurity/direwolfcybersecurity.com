---
/**
 * The Home statistics band: three cited third-party figures about the threat (claims register
 * rows S-STAT-3, S-STAT-2 and S-STAT-6, rule 13), each with its source beside it. The heading
 * claims no business size and no cost, because only S-STAT-3 is a small-business figure; the note
 * under the figures says they are not Direwolf results.
 *
 * Each item's rule is an accent bar (`data-stat`, src/styles/global.css "Statistics"): drawn at
 * rest; when its figure counts up (src/scripts/motion.ts) it grows in lockstep with the number.
 */
import StatFigure from './StatFigure.astro';
import { homeStats, statsNote } from '../data/stats';
---

<section aria-labelledby="stats-heading" class="bg-surface border-line border-b py-14 md:py-20">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Why it matters</p>
      <h2
        id="stats-heading"
        class="mt-2 text-3xl font-semibold tracking-tight text-balance md:text-4xl"
      >
        The threat, by the numbers
      </h2>
    </div>
    <ul class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6" data-reveal="stagger">
      {homeStats.map((stat) => (
        <li
          data-stat
          class="border-line relative border-t-2 pt-6 md:border-t-0 md:border-l-2 md:pt-0 md:pl-6"
        >
          <StatFigure stat={stat} />
        </li>
      ))}
    </ul>
    <p class="text-muted mt-10 text-xs">{statsNote}</p>
  </div>
</section>
