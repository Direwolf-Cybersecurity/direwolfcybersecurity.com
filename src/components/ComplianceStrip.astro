---
/**
 * The approved compliance wording, and nothing else. Rendered on the Platform page only; Home,
 * Services and About link to /compliance/ instead (claims register row H1). Change the phrases
 * in src/config.ts only after updating docs/claims-register.md.
 */
import { complianceStrip } from '../config';
---

<div class="border-line bg-surface border-y">
  <div class="container-x flex flex-col gap-3 py-4 md:flex-row md:items-center md:justify-between">
    <ul class="flex flex-wrap gap-x-3 gap-y-1 text-sm font-medium" aria-label="Compliance posture">
      {
        complianceStrip.map((item, index) => (
          <li class="flex items-center gap-3">
            {index > 0 && (
              <span aria-hidden="true" class="text-muted">
                &middot;
              </span>
            )}
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <a href="/compliance/" class="link text-sm">What these statements mean</a>
  </div>
</div>
