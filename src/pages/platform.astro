---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ComplianceStrip from '../components/ComplianceStrip.astro';
import CallToAction from '../components/CallToAction.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Icon from '../components/Icon.astro';
import { hasImage } from '../data/images';
import type { IconName } from '../data/icons';
import { PLATFORM_LIVE, loginUrl, signupUrl } from '../config';

/*
 * Platform (owner request 2026-10-29): short. A heading, one lede and two groups of key points,
 * so a customer understands that its data is protected and that the platform is designed to ease
 * the security work on its organization; the details live on the Compliance page. No
 * architecture, roadmap or status sections.
 *
 * Every point is true of how the platform is designed and built (docs/claims-register.md), and
 * every point about software that is not in service is in design form ("built to", "designed
 * to", rule 9), never as something a customer uses today: rows H1 and H7 (Platform form, "built
 * to run on", never "runs on" or "hosted on" until gate G8), H4 and H5 ("built to encrypt", never
 * "is encrypted" until G8), H8 (designed to run on Amazon Bedrock), S1-S3 and S6 (implemented in
 * code; the audit log is "built for" administrators to review), A3, A6 and A8's short form in
 * design form ("Designed so ..."), which carries row A2's oversight once on this page. The lede
 * names only the detection and response service: the other services are delivered by our team
 * (rows R2-R11), so the page never says "in one place" or "every Direwolf service" (row W6). No
 * FedRAMP wording here, so no row H2 disclaimer is needed.
 * The only call to action is "Contact us" while PLATFORM_LIVE is false (row W6); Sign up and Log
 * in return when it is true. Icons are static (motion copy rule 9).
 */
const description =
  'How the Direwolf Platform is built to keep your data protected and to take security work off your team, with AI overseen by our security professionals.';

// 25 words or fewer (docs/design-direction.md rule 12).
const lede =
  'The Direwolf Platform is the system behind our detection and response service. It is designed to take security work off your team.';

type Point = { icon: IconName; title: string; text: string };

// Each point's text is 20 words or fewer (docs/design-direction.md rule 12).
const protectedPoints: Point[] = [
  {
    icon: 'lock',
    title: 'Built to encrypt in transit and at rest',
    text: 'TLS 1.2 or later for every connection, and keys held in AWS Key Management Service for stored data.',
  },
  {
    icon: 'server',
    title: 'In the United States, on AWS',
    text: 'Built to run on Amazon Web Services in the US West (Oregon) Region, with backups in US East (Ohio).',
  },
  {
    icon: 'database',
    title: 'Your data kept separate',
    text: 'Each customer’s data is kept apart from every other customer’s, enforced by the database on every query.',
  },
  {
    icon: 'key-round',
    title: 'Multi-factor sign-in',
    text: 'Multi-factor authentication is required for every user, and new users join by invitation only.',
  },
  {
    icon: 'scroll-text',
    title: 'Every important action recorded',
    text: 'Administrative and security-relevant actions are written to a tamper-evident audit log built for your administrators to review.',
  },
  {
    icon: 'cloud',
    title: 'AI analysis in AWS US Regions',
    text: 'Designed to run on Amazon Bedrock, so your alerts are analyzed within AWS and not used to train models.',
  },
];

const lessWorkPoints: Point[] = [
  {
    icon: 'network',
    title: 'One partner for detection, testing and compliance',
    text: 'Detection and response, testing, compliance and security planning from one provider, so you manage one relationship.',
  },
  {
    icon: 'brain-circuit',
    title: 'AI handles the alert noise',
    text: 'Designed so AI security analysts and responders work every alert around the clock, overseen by our team of security professionals.',
  },
  {
    icon: 'mail',
    title: 'Plain-English reports',
    text: 'A plain-English summary of every alert, and a written report of what to fix after every test or review.',
  },
  {
    icon: 'shield-check',
    title: 'You set the guardrails',
    text: 'AI responders are built to act only within guardrails you control, with one-click undo; risk analyses wait for your sign-off.',
  },
];

const withImage = hasImage('platform');
---

<BaseLayout title="Platform" description={description} progress>
  <PageHeader eyebrow="The Direwolf Platform" title="Built to protect your data" lede={lede}>
    {PLATFORM_LIVE ? (
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={signupUrl} class="btn btn-primary" rel="noopener noreferrer">
          Sign up
        </a>
        <a href={loginUrl} class="btn btn-secondary" rel="noopener noreferrer">
          Log in
        </a>
      </div>
    ) : (
      <div class="mt-8">
        <a href="/contact/?topic=platform" class="btn btn-primary">
          Contact us
        </a>
      </div>
    )}
  </PageHeader>

  {/* `security` is the anchor the Security page links to. */}
  <Section id="security" eyebrow="Security" title="Your data stays protected">
    <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
      {protectedPoints.map((point) => (
        <li class="flex gap-4">
          <span class="icon-tile">
            <Icon name={point.icon} class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-semibold">{point.title}</h3>
            <p class="text-muted mt-1 text-sm leading-relaxed">{point.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <ComplianceStrip class="mt-12" />
  </Section>

  <Section id="less-work" tone="surface">
    <div class:list={['grid gap-12', withImage && 'lg:grid-cols-2 lg:items-center lg:gap-16']}>
      <div>
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">For your team</p>
          <h2 id="less-work-heading" class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
            Less security work for your team
          </h2>
        </div>
        <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2" data-reveal="stagger">
          {lessWorkPoints.map((point) => (
            <li class="flex gap-4">
              <span class="icon-tile">
                <Icon name={point.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-semibold">{point.title}</h3>
                <p class="text-muted mt-1 text-sm leading-relaxed">{point.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      {withImage && <ImageSlot id="platform" />}
    </div>
  </Section>

  {PLATFORM_LIVE ? (
    <CallToAction
      title="See it for yourself."
      text="Create an account to explore the dashboard. You are only charged when you buy licenses."
    />
  ) : (
    <CallToAction
      title="Questions about the platform?"
      text="Tell us about your organization and what you need, and we will be in touch."
    />
  )}
</BaseLayout>
