---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ComplianceStrip from '../components/ComplianceStrip.astro';
import CallToAction from '../components/CallToAction.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Icon from '../components/Icon.astro';
import { hasImage } from '../data/images';
import type { IconName } from '../data/icons';
import { PLATFORM_LIVE, earlyAccessUrl, loginUrl, signupUrl } from '../config';

// While the platform is not in service the description and lede use the future tense (claims
// register row W6); the present-tense forms return when PLATFORM_LIVE is true.
const description = PLATFORM_LIVE
  ? 'The Direwolf Platform is the web application behind every Direwolf service: buy licenses, download organization-bound installers, invite users, and see what the SOC did.'
  : 'The Direwolf Platform is the web application behind every Direwolf service: your administrators will use it to buy licenses, download organization-bound installers, invite users, and see what the SOC did.';

// 25 words or fewer (row W6). The monitoring idea is said once on this page, in the AI SOC card
// below (row A8, which carries row A2's oversight wording).
const lede = PLATFORM_LIVE
  ? 'Your administrators buy licenses, deploy sensors and see what the AI SOC did.'
  : 'Your administrators will buy licenses, deploy sensors and see what the AI SOC did.';

const features: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'layout-dashboard',
    title: 'Overview',
    text: 'Open alerts, sensor health, seat usage and recent SOC actions at a glance.',
  },
  {
    icon: 'bell',
    title: 'Alerts',
    text: 'Each alert with its timeline, a plain-English summary and the actions taken.',
  },
  {
    icon: 'cpu',
    title: 'Sensors',
    text: 'Health, last check-in and version, with installers bound to your organization.',
  },
  {
    icon: 'user-plus',
    title: 'Users',
    text: 'Invitations, roles, MFA status and active sessions.',
  },
  {
    icon: 'scroll-text',
    title: 'Audit log',
    text: 'Every login, change and SOC action.',
  },
  {
    icon: 'settings',
    title: 'Settings and billing',
    text: 'Notification recipients, session timeout, sign-in banner, licenses and payments.',
  },
];

// Claims register rows H1, H9 and H10 (Platform forms, H9 and H10 after "Roadmap:" so Terms
// §3.3 covers them) with H2 verbatim in the same item, S1-S7, H4/H5 (short forms), and the AI SOC
// item, row A8's Platform form, which carries row H8's Bedrock short form and row A2's oversight
// in one sentence (future tense until row H8's gate closes). FedRAMP appears only in the Hosting
// item, never in a heading. Hosting and Encryption keep their full approved wording and span the
// grid; every other item is one sentence within the 20-word card limit of
// docs/design-direction.md rule 12.
const security: { icon: IconName; title: string; text: string; wide?: boolean }[] = [
  {
    icon: 'server',
    title: 'Hosting',
    text: 'The platform is built to run on AWS in the US West (Oregon) Region, with backups in US East (Ohio), using private networks, a web application firewall, and controlled egress. AWS reports both Regions at the FedRAMP Moderate baseline. It is not yet in service. Roadmap: we plan to move it to AWS GovCloud (US) as we onboard customers who need it, and we intend to pursue FedRAMP authorization for the Direwolf Platform as our customers require it. Direwolf itself is not FedRAMP certified or authorized. AWS’s FedRAMP certification belongs to AWS, not to the Direwolf Platform.',
    wide: true,
  },
  {
    icon: 'database',
    title: 'Tenant isolation',
    text: 'Each organization is isolated in the database by PostgreSQL row-level security on every query.',
  },
  {
    icon: 'key-round',
    title: 'Identity',
    text: 'Multi-factor authentication is mandatory for every user, and new users join by invitation only.',
  },
  {
    icon: 'timer',
    title: 'Sessions',
    text: 'Sessions lock after 15 idle minutes, and privileged actions require a fresh MFA check.',
  },
  {
    icon: 'brain-circuit',
    title: 'AI SOC',
    text: 'AI analysts will triage every alert using Amazon Bedrock in AWS US Regions, overseen by our security professionals.',
  },
  {
    icon: 'scroll-text',
    title: 'Audit logging',
    text: 'Every administrative and security-relevant action goes to an append-only, hash-chained audit log.',
  },
  {
    icon: 'git-pull-request',
    title: 'Operations',
    text: 'Infrastructure as code, reviewed in pull requests, with images and dependencies scanned in CI.',
  },
  {
    icon: 'lock',
    title: 'Encryption',
    text: 'When the platform is in service, connections will use TLS 1.2 or later with a FIPS 140-validated security policy at the edge, and data at rest will be encrypted with customer-managed keys in AWS Key Management Service, whose hardware security modules are FIPS 140-validated.',
    wide: true,
  },
];

const withImage = hasImage('platform');
---

<BaseLayout title="Platform" description={description}>
  <PageHeader eyebrow="The Direwolf Platform" title="Your security, in one place" lede={lede}>
    {PLATFORM_LIVE ? (
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={signupUrl} class="btn btn-primary" rel="noopener noreferrer">
          Sign up
        </a>
        <a href={loginUrl} class="btn btn-secondary" rel="noopener noreferrer">
          Log in
        </a>
      </div>
    ) : (
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={earlyAccessUrl} class="btn btn-primary">
          Request early access
        </a>
        <p class="text-muted text-sm">The Direwolf Platform is opening to early customers.</p>
      </div>
    )}
  </PageHeader>

  <Section id="for-your-team">
    <div class:list={['grid gap-12', withImage && 'lg:grid-cols-2 lg:items-center lg:gap-16']}>
      <div>
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">For your team</p>
          <h2
            id="for-your-team-heading"
            class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl"
          >
            {PLATFORM_LIVE ? 'What your administrators see' : 'What your administrators will see'}
          </h2>
        </div>
        <ul
          class:list={['mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2', !withImage && 'lg:grid-cols-3']}
          data-reveal="stagger"
        >
          {features.map((feature) => (
            <li class="flex gap-4">
              <span class="icon-tile">
                <Icon name={feature.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-semibold">{feature.title}</h3>
                <p class="text-muted mt-1 text-sm leading-relaxed">{feature.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      {withImage && <ImageSlot id="platform" />}
    </div>
  </Section>

  <Section
    id="security"
    tone="surface"
    eyebrow="How it is built"
    title="Security, in plain language"
    lede="The details will be documented in our system security plan and customer responsibility matrix, which we will make available to customers and their assessors."
  >
    <ul class="mt-12 grid gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3" data-reveal="stagger">
      {security.map((item) => (
        <li
          class:list={[
            'card flex flex-col gap-3 sm:flex-row sm:gap-4',
            item.wide && 'md:col-span-2 lg:col-span-3',
          ]}
        >
          <span class="icon-tile">
            <Icon name={item.icon} class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-semibold">{item.title}</h3>
            <p class:list={['text-muted mt-1 text-sm leading-relaxed', item.wide && 'max-w-4xl']}>
              {item.text}
            </p>
          </div>
        </li>
      ))}
    </ul>
    <ComplianceStrip class="mt-10" />
    <p class="text-muted mt-8 max-w-prose text-sm">
      This describes the platform as designed and built for launch. For the status of our compliance
      program, and exactly what we do and do not claim, see the{' '}
      <a href="/compliance/" class="link">
        Compliance
      </a>{' '}
      page.
    </p>
  </Section>

  {PLATFORM_LIVE ? (
    <CallToAction
      title="See it for yourself."
      text="Create an account to explore the dashboard. You are only charged when you buy licenses."
    />
  ) : (
    <CallToAction
      title="Be among the first to use it."
      text="The Direwolf Platform is opening to early customers. Tell us about your organization and we will be in touch."
    />
  )}
</BaseLayout>
