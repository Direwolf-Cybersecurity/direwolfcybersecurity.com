---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import CallToAction from '../components/CallToAction.astro';
import Experience from '../components/Experience.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Icon from '../components/Icon.astro';
import StatsBand from '../components/StatsBand.astro';
import SystemFlow from '../components/SystemFlow.astro';
import { services, moreServices } from '../data/services';
import { hasImage } from '../data/images';
import { shownEngagements } from '../data/engagements';
import type { IconName } from '../data/icons';
import { PLATFORM_LIVE, signupUrl } from '../config';

/*
 * Home (owner direction 2026-10-24): an AI-driven managed security services provider for any
 * small or mid-size business. Short copy, one idea per section, a visual element in each, and
 * each idea said once: the positioning line (row A8, owner decision 2026-10-26), which carries
 * the monitoring idea (row A2), is the hero subhead, verbatim. It is the only place on the site
 * that names the AI engineers (owner intent, not built; row A8's gate, launch runbook G20); the
 * "How it works" steps name only the AI roles built in the platform's code (analysts triage,
 * responders contain). Every claim is in docs/claims-register.md (rows F1, F5, A1-A4, A6-A8,
 * C1, C5, R2-R5, S-STAT-2, S-STAT-3, S-STAT-6, W6). While the platform is not in service the
 * hero's primary button is "Contact us" (row W6: no early access, owner direction 2026-10-27).
 * After the four core service cards, four of the other services are linked tags (`homeTag`,
 * rows R2-R5; owner decision 2026-10-29: every service is current, with no roadmap) with a link
 * to all of them on Services, so they do not outweigh the four cards (design-direction rule 6).
 *
 * Motion (motion system v2, 2026-10-28; docs/design-direction.md): one high-novelty moment per
 * viewport. The hero plays once at load (CSS only, at rest by 2.0 s; its text never moves), the
 * statistics count up, and "How it works" is the flow (src/components/SystemFlow.astro, its
 * strings in src/data/flow.ts, register row D1), which plays once when it comes into view; the
 * statistics band and the services sit between the two. The services grid's link cards catch
 * light under the pointer (`data-spotlight`) and the Why Direwolf icons draw as they are
 * revealed, except those beside status or compliance wording (motion copy rule 9: no animated
 * checks or seals on status or compliance content), which stay static, as does the hero's
 * veteran-owned proof icon. Section order is today's (motion gate 5 would move "How it works" up
 * to directly after the statistics band).
 */
const homeMore = moreServices.filter((item) => item.homeTag);

/*
 * Hero: the owner's image (src/assets/images/hero.webp, composed with an empty dark left third
 * and the shield on the right) is a full-bleed background at every width, under a near-black
 * scrim that keeps the text at 4.5:1 or better (.hero-media in src/styles/global.css). From sm
 * (640 px) up the text column is capped at 58% of the container so it stays clear of the shield;
 * on narrower phones the shield sits centred and low, behind a stronger scrim. Without the image
 * the hero is a little shorter: text on the CSS glow backdrop.
 */
const withHeroImage = hasImage('hero');

// The hero's one-pass silver edge-light across the shield (motion gate 4): off until the owner has
// seen it in a local preview and kept it.
const heroEdgeLight = false;
const heroHeight = withHeroImage
  ? 'pb-24 sm:flex sm:min-h-[36rem] sm:items-center sm:py-16 md:min-h-[38rem] md:py-20 lg:min-h-[40rem] lg:py-24'
  : 'pb-10 lg:flex lg:min-h-[30rem] lg:items-center lg:py-24';

// Three proof points, the first saying what no other Home section says (the subhead already says
// the AI SOC works every alert; the EDR card and Detect step do not name the operating systems),
// each with its own icon. The first two icons draw at load; the third, beside an ownership status,
// stays static (motion copy rule 9). Keep three: with two, the hero is shorter from about 960 px
// up, the image reframes, and the subhead's second line drops below 4.5:1 at 960-1060 px.
const proofPoints: { icon: IconName; text: string }[] = [
  { icon: 'cpu', text: 'EDR for Windows, macOS and Linux' },
  { icon: 'crosshair', text: 'Penetration tests with a written report' },
  { icon: 'badge-check', text: 'Service-disabled veteran-owned' },
];

// `draw: false`: static beside status or compliance wording (motion copy rule 9).
const reasons: { icon: IconName; title: string; text: string; draw?: false }[] = [
  {
    icon: 'network',
    title: 'One partner for detection, testing and compliance',
    text: 'Detection and response, endpoint protection, penetration testing, compliance readiness and security planning from one provider.',
  },
  {
    icon: 'wallet',
    title: 'Priced for small business',
    text: 'Per-endpoint pricing for managed detection and endpoint protection, with no hardware to buy.',
  },
  {
    icon: 'badge-check',
    title: 'Veteran-owned',
    text: 'An SBA-certified Service-Disabled Veteran-Owned Small Business in Colorado Springs, Colorado.',
    draw: false,
  },
  {
    icon: 'landmark',
    title: 'When your contracts raise the bar',
    text: 'Compliance readiness for NIST SP 800-171, CMMC and similar frameworks when your contracts call for it.',
    draw: false,
  },
];
---

<BaseLayout title="Home">
  <section
    aria-labelledby="hero-heading"
    data-oneshot
    class:list={[
      'dark-band relative isolate overflow-hidden',
      !withHeroImage && 'glow-backdrop glow-backdrop-animated',
    ]}
  >
    <ImageSlot id="hero" variant="backdrop" glint={heroEdgeLight} />
    <div class:list={['container-x relative z-10 pt-14 md:pt-20', heroHeight]}>
      <div class:list={['max-w-xl', withHeroImage && 'sm:max-w-[min(36rem,58%)]']}>
        <p class="eyebrow accent-sweep">AI-driven managed security</p>
        <h1
          id="hero-heading"
          class="mt-4 text-4xl font-semibold tracking-[-0.03em] text-balance md:text-5xl lg:text-6xl"
        >
          Enterprise-grade security, sized for your business.
        </h1>
        <p class="text-muted mt-6 text-lg md:text-xl">
          A next-gen AI SOC: AI security analysts, engineers and responders work every alert around
          the clock, overseen by our team of security professionals.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {PLATFORM_LIVE ? (
            <a href={signupUrl} class="btn btn-primary" rel="noopener noreferrer">
              Get started
            </a>
          ) : (
            <a href="/contact/" class="btn btn-primary">
              Contact us
            </a>
          )}
          <a href="/services/" class="btn btn-secondary">
            See services
          </a>
        </div>
        <ul class="hero-proof mt-10 flex flex-col gap-3 text-sm sm:flex-row sm:flex-wrap sm:gap-x-6">
          {proofPoints.map((point, index) => (
            <li class="flex items-center gap-2">
              <Icon
                name={point.icon}
                class="text-accent h-5 w-5"
                draw={index < 2 ? ((index + 1) as 1 | 2) : false}
              />
              <span>{point.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <StatsBand />

  <Section id="services" eyebrow="Services" title="Four core services. One security partner.">
    <div
      class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"
      data-reveal="stagger"
      data-spotlight
    >
      {services.map((service) => (
        <Card
          title={service.name}
          href={`/services/#${service.id}`}
          icon={service.icon}
          titleClass="lg:min-h-[3.5rem]"
        >
          <p>{service.summary}</p>
        </Card>
      ))}
    </div>
    <div class="mt-10 flex flex-col gap-3 text-sm sm:flex-row sm:items-start" data-reveal>
      <p class="text-muted shrink-0 font-semibold sm:py-1">Also from Direwolf:</p>
      <div>
        <ul class="flex flex-wrap gap-2" aria-label="More services">
          {homeMore.map((item) => (
            <li>
              <a
                href={`/services/#${item.id}`}
                class="border-line text-muted hover:border-accent hover:text-fg inline-block rounded-full border px-3 py-1 no-underline transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3">
          <a href="/services/" class="link">
            See all our services
          </a>
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="how-it-works"
    tone="dark"
    eyebrow="How it works"
    title="From alert to action in three steps"
  >
    <SystemFlow class="mt-12" />
  </Section>

  <Section
    id="why-direwolf"
    tone="surface"
    eyebrow="Why Direwolf"
    title="Built for businesses like yours"
  >
    <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2" data-reveal="stagger">
      {reasons.map((reason) => (
        <li class="flex gap-4">
          <span class="icon-tile">
            <Icon
              name={reason.icon}
              class="h-5 w-5"
              draw={reason.draw === false ? false : 'reveal'}
            />
          </span>
          <div>
            <h3 class="text-lg font-semibold">{reason.title}</h3>
            <p class="text-muted mt-1 leading-relaxed">{reason.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-12 text-sm font-medium">
      Where we stand on NIST SP 800-171, CMMC and hosting:{' '}
      <a href="/compliance/" class="link">
        see our Compliance page
      </a>
      .
    </p>
  </Section>

  <Experience variant="summary" />

  {/* Experience (when shown) is on the page background too, so no second top padding here. */}
  <CallToAction flushTop={shownEngagements.length > 0} />
</BaseLayout>
