---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import CallToAction from '../components/CallToAction.astro';
import { launchServices } from '../data/services';
import { signupUrl } from '../config';

const valueProps = [
  {
    title: 'Always-on detection and response',
    text: 'Every alert from your endpoints is triaged around the clock by our AI analyst. Confirmed threats are contained automatically under guardrails you control, and a human analyst reviews what the AI did.',
  },
  {
    title: 'Built for organizations that answer to assessors',
    text: 'We build the platform for organizations that answer to assessors, and we tell you plainly which responsibilities are ours and which remain yours. Our Compliance page says exactly where we stand.',
  },
  {
    title: 'Sized and priced for smaller teams',
    text: 'Per-endpoint pricing, no hardware to buy, and a dashboard your own administrators can run: buy licenses, download installers, invite users, and see what happened.',
  },
];

const steps = [
  {
    title: 'Sign up and choose your services',
    text: 'Create your account and your organization, then select the services and license counts you need. Pay by card, and your organization is provisioned as soon as the payment clears.',
  },
  {
    title: 'Deploy sensors',
    text: 'Download installers bound to your organization and run them on your Windows, macOS, and Linux endpoints. Each sensor reports to your organization from its first check-in.',
  },
  {
    title: 'We watch, you stay informed',
    text: 'The Direwolf AI SOC triages every alert, contains confirmed threats, and explains what happened in plain English. Your dashboard shows alerts, sensor health, and your own audit log.',
  },
];
---

<BaseLayout title="Home">
  <section aria-labelledby="hero-heading" class="py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">Managed security for small and mid-size organizations</p>
        <h1 id="hero-heading" class="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">
          Security operations built for enterprises, sized for your organization.
        </h1>
        <p class="text-muted mt-6 text-lg md:text-xl">
          Direwolf Cybersecurity runs an AI-operated security operations center with a human analyst
          reviewing. Protect every endpoint, support your NIST SP 800-171 program, and get back to
          work.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={signupUrl} class="btn btn-primary">
            Get started
          </a>
          <a href="/services/" class="btn btn-secondary">
            See our services
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="border-line bg-surface border-y">
    <div class="container-x py-4">
      <p class="text-sm font-medium">
        Where we stand on NIST SP 800-171, CMMC and hosting:
        <a href="/compliance/" class="link">
          see our Compliance page
        </a>
        .
      </p>
    </div>
  </div>

  <Section id="why" eyebrow="Why Direwolf" title="Security operations without the overhead">
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {valueProps.map((item) => (
        <Card title={item.title}>
          <p>{item.text}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section id="how" tone="surface" eyebrow="How it works" title="Up and running in three steps">
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((step, index) => (
        <li class="card">
          <p class="text-accent font-mono text-sm font-semibold">Step {index + 1}</p>
          <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
          <p class="text-muted mt-3 text-sm leading-relaxed">{step.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    id="services"
    eyebrow="Services"
    title="What we offer at launch"
    lede="Four services, one platform, one bill. Everything we plan to add later is listed as roadmap, never as available."
  >
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {launchServices.map((service) => (
        <Card title={service.name} href={`/services/#${service.id}`}>
          <p>{service.summary}</p>
        </Card>
      ))}
    </div>
    <p class="mt-8">
      <a href="/services/#roadmap" class="link">
        See what is on the roadmap
      </a>
    </p>
  </Section>

  <CallToAction />
</BaseLayout>
