---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CallToAction from '../components/CallToAction.astro';
import Experience from '../components/Experience.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Icon from '../components/Icon.astro';
import { hasImage } from '../data/images';
import { shownEngagements } from '../data/engagements';
import type { IconName } from '../data/icons';
import { industries, hqLine, ownershipStatement, ownershipPhrase } from '../config';

// Claims register rows F1-F5, C1, C2 (one sentence each on About), A2 and H1 (pointer only, in the
// "Regulated industries" section).
const description = `Direwolf Cybersecurity is ${ownershipPhrase} headquartered in Colorado Springs, Colorado, bringing AI-driven detection and response, monitored by a team of security professionals, to small and mid-size businesses.`;

const industryIcons: Record<(typeof industries)[number], IconName> = {
  Healthcare: 'heart-pulse',
  Manufacturing: 'factory',
  Defense: 'shield',
  Aerospace: 'plane',
  Space: 'rocket',
  Technology: 'cpu',
};

const withImage = hasImage('about');
---

<BaseLayout title="About us" description={description}>
  <PageHeader
    eyebrow="About us"
    title="Why we built Direwolf"
    lede="Most small businesses have no security team of their own, yet they face the same adversaries as everyone else."
  />

  <Section id="mission">
    <div class:list={['grid gap-12', withImage && 'lg:grid-cols-2 lg:items-center lg:gap-16']}>
      <div data-reveal>
        <p class="eyebrow">Our mission</p>
        <h2 id="mission-heading" class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
          Protection that does not depend on size
        </h2>
        <div class="prose mt-6 text-lg">
          <p>
            We built Direwolf Cybersecurity to give small and mid-size businesses the security
            operations, endpoint protection, penetration testing and compliance support that large
            enterprises take for granted.
          </p>
          <p>
            AI-driven detection and response, monitored by a team of security professionals, lets us
            offer that protection at a price a small business can carry.
          </p>
        </div>
      </div>
      {withImage && <ImageSlot id="about" />}
    </div>
  </Section>

  <Section
    id="who-we-are"
    tone="surface"
    eyebrow="Who we are"
    title="Cyber professionals from high-stakes industries"
    lede="Our cyber professionals bring experience from healthcare, manufacturing, defense, aerospace, space and technology."
  >
    <ul
      class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3"
      aria-label="Industries"
      data-reveal="stagger"
    >
      {industries.map((industry) => (
        <li class="flex items-center gap-3 font-medium">
          <Icon name={industryIcons[industry]} class="text-accent h-6 w-6" />
          {industry}
        </li>
      ))}
    </ul>
  </Section>

  <Section id="regulated">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start lg:gap-16" data-reveal>
      <div>
        <p class="eyebrow">Regulated industries</p>
        <h2
          id="regulated-heading"
          class="mt-2 text-3xl font-semibold tracking-tight text-balance md:text-4xl"
        >
          Ready when your contracts raise the bar
        </h2>
      </div>
      <div class="text-muted text-lg lg:pt-6">
        <p>
          For government contractors and other regulated businesses, we help with NIST SP 800-171,
          CMMC and similar frameworks. Direwolf itself is aligned to NIST SP 800-171 and pursuing
          CMMC Level 2 certification.
        </p>
        <p class="mt-4">
          <a href="/compliance/" class="link">
            See our Compliance page
          </a>{' '}
          for the current status, where the Direwolf Platform runs, and exactly what we do and do
          not claim.
        </p>
      </div>
    </div>
  </Section>

  <Section id="company" tone="dark" eyebrow="Company" title="Veteran-owned, Colorado-based">
    <dl class="mt-10 grid gap-8 md:grid-cols-3" data-reveal="stagger">
      <div>
        <dt class="flex items-center gap-3 font-semibold">
          <span class="icon-tile">
            <Icon name="map-pin" class="h-5 w-5" />
          </span>
          Headquarters
        </dt>
        <dd class="text-muted mt-2 pl-14 text-sm">{hqLine}</dd>
      </div>
      <div>
        <dt class="flex items-center gap-3 font-semibold">
          <span class="icon-tile">
            <Icon name="badge-check" class="h-5 w-5" />
          </span>
          Ownership
        </dt>
        <dd class="text-muted mt-2 pl-14 text-sm">{ownershipStatement}</dd>
      </div>
      <div>
        <dt class="flex items-center gap-3 font-semibold">
          <span class="icon-tile">
            <Icon name="users" class="h-5 w-5" />
          </span>
          Equal opportunity employer
        </dt>
        <dd class="text-muted mt-2 pl-14 text-sm">
          <a href="/legal/eeo/" class="link">
            Read our EEO statement
          </a>
        </dd>
      </div>
    </dl>
  </Section>

  <Experience variant="full" />

  {/* Experience (when shown) is on the page background too, so no second top padding here. */}
  <CallToAction
    flushTop={shownEngagements.length > 0}
    title="Want to talk to us?"
    text="We are glad to discuss your environment, your goals, and whether Direwolf is the right fit."
  />
</BaseLayout>
