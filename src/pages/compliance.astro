---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { hqLine, legalEntityName, ownershipStatement } from '../config';

const description =
  'Where Direwolf Cybersecurity stands on NIST SP 800-171 and CMMC Level 2, where the Direwolf Platform is built to run and how its data will be encrypted, and what we do not claim.';

/** Update when this page is re-checked against docs/claims-register.md. */
const lastReviewed = { iso: '2026-10-25', label: 'October 25, 2026' };

// Claims register rows C1, C2, H1 (long form) with H2, H4/H5 with H6 (first sentence), and
// H9 with L7 (export-controlled data only) and H10 with H2's first sentence, under a "Roadmap"
// title so Terms §3.3 covers them. `wide` spans the grid.
const posture: { claim: string; meaning: string; wide?: boolean }[] = [
  {
    claim: 'Aligned to NIST SP 800-171',
    meaning:
      'We have mapped NIST SP 800-171 (Revision 2, as used by CMMC Level 2) to the Direwolf Platform and to our company practices, and we are building the system security plan, control matrix with evidence, and plan of action and milestones that an assessment requires. "Aligned" means we implement the requirements as we understand them and keep evidence of it. It is not a third-party certification.',
  },
  {
    claim: 'Pursuing CMMC Level 2',
    meaning:
      'Direwolf is preparing for a CMMC Level 2 assessment. In July 2026 the Department of War suspended the requirement for third-party (C3PAO) Level 2 assessments while it reviews the CMMC program; self-assessment requirements remain in force. We will update this page when our status changes. Until an assessment is complete and recorded, we do not describe Direwolf as CMMC certified.',
  },
  {
    claim: 'Built for AWS US West (Oregon)',
    meaning:
      'The Direwolf Platform is built to run on Amazon Web Services in the US West (Oregon) Region, with backups in US East (Ohio), and is not yet in service. AWS states that its US East and US West Regions are FedRAMP Certified at Class C (formerly the FedRAMP Moderate baseline). Direwolf itself is not FedRAMP certified or authorized. AWS’s FedRAMP certification belongs to AWS, not to the Direwolf Platform.',
  },
  {
    claim: 'Designed for FIPS 140-validated TLS and key management',
    meaning:
      'When the Platform is in service, data in transit will be protected with TLS 1.2 or higher, terminated with a FIPS 140-validated cryptographic module (AWS-LC, CMVP certificate #4631), and data at rest (databases, object storage, queues, secrets and logs) will be encrypted with customer-managed keys held in AWS KMS hardware security modules validated to FIPS 140-3 Level 3 (CMVP certificate #4884), with automatic key rotation. The Platform’s application is designed to call AWS services only through AWS FIPS endpoints, which use FIPS 140-validated cryptographic modules, wherever AWS provides them. We make no FIPS claim about any other component.',
  },
  {
    claim: 'Roadmap: AWS GovCloud (US)',
    meaning:
      'We plan to move the Platform to AWS GovCloud (US) as we onboard customers who need it. The Platform is not approved to receive export-controlled technical data (ITAR or EAR). We intend to pursue FedRAMP authorization for the Direwolf Platform as our customers require it. Direwolf itself is not FedRAMP certified or authorized.',
    wide: true,
  },
];

const notClaimed = [
  'Direwolf is not FedRAMP authorized. Our infrastructure provider’s authorization is not ours.',
  'Direwolf is not yet CMMC certified.',
  'We do not hold SOC 2 or ISO/IEC 27001 attestations.',
  'Our compliance readiness service is not legal advice and does not replace an assessment of your own organization by an authorized assessor.',
];
---

<BaseLayout title="Compliance" description={description}>
  <PageHeader
    eyebrow="Compliance"
    title="What we claim, what we are pursuing, and what we do not claim"
    lede="Compliance statements are easy to make and hard to back up. This page says precisely where Direwolf stands, and it changes when our status changes."
  />

  <Section id="posture" title="Our posture">
    <dl class="mt-8 grid gap-6 md:grid-cols-2">
      {posture.map((item) => (
        <div class:list={['card', item.wide && 'md:col-span-2']}>
          <dt class="text-lg font-semibold">{item.claim}</dt>
          <dd class="text-muted mt-3 text-sm leading-relaxed">{item.meaning}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="shared-responsibility" tone="surface" title="Shared responsibility">
    <div class="prose mt-6">
      <p>
        When you use Direwolf, three parties share the security of the service. AWS is responsible
        for the physical and virtual infrastructure of the AWS Regions the Platform is built to run
        in and for the FIPS-validated cryptographic modules we rely on. Direwolf is responsible for
        everything inside the platform boundary: tenant isolation, identity and multi-factor
        authentication, session controls, audit logging, configuration and vulnerability management,
        encryption configuration, incident handling for the platform, and the guardrails around the
        AI SOC. You remain responsible for your own people and endpoints: who gets an account and
        which role, removing leavers promptly, protecting MFA devices, installing sensors only on
        endpoints you own, reviewing your organization&rsquo;s audit log, acting on notifications,
        and the organizational policies that no technology provides. Our customer responsibility
        matrix, which we are completing as controls are implemented, will spell this out requirement
        by requirement.
      </p>
    </div>
    <p class="mt-8">
      <a href="/contact/" class="btn btn-secondary">
        Ask about the customer responsibility matrix
      </a>
    </p>
  </Section>

  <Section id="cui" title="A note on controlled unclassified information (CUI)">
    <div class="prose mt-6">
      <p>
        At launch, the Direwolf Platform handles security protection data: alerts, sensor inventory,
        triage notes, and your users&rsquo; accounts. It is not designed to store, process, or
        transmit CUI, and customers should not place CUI in alert notes, settings, or support
        messages. A cloud service that stores, processes, or transmits CUI is subject to additional
        federal authorization requirements that do not apply to the security protection data we
        handle today. A CUI document repository is on our roadmap and would be subject to those
        requirements before release.
      </p>
    </div>
  </Section>

  <Section id="company-facts" tone="surface" title="Company facts">
    <dl class="mt-8 grid gap-6 md:grid-cols-3">
      <div class="card">
        <dt class="font-semibold">Ownership</dt>
        <dd class="text-muted mt-2 text-sm">
          {ownershipStatement}. Certified by the U.S. Small Business Administration through its
          Veteran Small Business Certification (VetCert) program.
        </dd>
      </div>
      <div class="card">
        <dt class="font-semibold">Legal name and headquarters</dt>
        <dd class="text-muted mt-2 text-sm">
          {legalEntityName}, headquartered in {hqLine}.
        </dd>
      </div>
      <div class="card">
        <dt class="font-semibold">Equal opportunity employer</dt>
        <dd class="text-muted mt-2 text-sm">
          Direwolf Cybersecurity is an equal opportunity employer. Read our{' '}
          <a href="/legal/eeo/" class="link">
            EEO statement
          </a>
          .
        </dd>
      </div>
    </dl>
  </Section>

  <Section id="not-claimed" title="What we do not claim">
    <ul class="prose mt-6 list-disc space-y-2 pl-6">
      {notClaimed.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </Section>

  <div class="container-x py-8">
    <p class="text-muted text-sm">
      Last reviewed <time datetime={lastReviewed.iso}>{lastReviewed.label}</time>. Every statement
      on this site is checked against our internal claims register before it is published.
    </p>
  </div>
</BaseLayout>
